# prod | fake
SPRING_PROFILES_ACTIVE=prod

# HTTP
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# API token: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-long-random-string
ADMIN_TOKEN_HEADER=X-Admin-Token

# Login page: htpasswd -nbBC 12 admin 'password' | cut -d: -f2 (in single quotes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

APP_ZONE=Asia/Almaty

# Message
MESSAGE_CONTACT=
MESSAGE_NUMBERING=false
MESSAGE_TEMPLATE_PATH=/data/templates/message.txt

# WhatsApp
WA_DEVICE_NAME=wa-group-sender
WA_SEND_TIMEOUT=60s
WA_GROUPS_TIMEOUT=4m
BRIDGE_LOG_LEVEL=INFO
BRIDGE_SENDER_KEY_GROUPS=
BRIDGE_SENDER_KEY_LIMIT=600

# Reconnect watchdog
WATCHDOG_CHECK_INTERVAL=15s
WATCHDOG_MAX_ATTEMPTS=8
WATCHDOG_INITIAL_DELAY=10s
WATCHDOG_MAX_DELAY=15m
WATCHDOG_CONNECT_TIMEOUT=3m

# Google Sheets (off; key in ./secrets/)
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_ID=
SHEETS_SHEET_NAME=Заявки
GOOGLE_CREDENTIALS_PATH=/run/secrets/google-service-account.json
SHEETS_POLL_INTERVAL=30s
SHEETS_HEADER_ROW=1
SHEETS_COL_ID=ID
SHEETS_COL_ROUTE=Маршрут
SHEETS_COL_DATE=Дата / срочность
SHEETS_COL_VEHICLES=Машины и тоннаж
SHEETS_COL_CARGO=Груз
SHEETS_COL_FREIGHT=Фрахт
SHEETS_COL_CONDITIONS=Доп. условия
SHEETS_COL_STATUS=Статус
SHEETS_COL_PROGRESS=Отправлено / всего
SHEETS_COL_COMPLETED=Завершено
SHEETS_PROGRESS_FLUSH_INTERVAL=60s
SHEETS_RETRY_MAX_ATTEMPTS=5
SHEETS_RETRY_INITIAL_BACKOFF=2s
SHEETS_RETRY_MAX_BACKOFF=60s
SHEETS_ALERT_AFTER_FAILURES=10
SHEETS_COMPLETED_FORMAT=yyyy-MM-dd HH:mm

# Groups
GROUPS_SYNC_INTERVAL=1h
GROUPS_MAX_PARTICIPANTS=0
GROUPS_INITIAL_SYNC_DELAY=60s

# Dispatch
DISPATCH_AUTOSTART=true
DISPATCH_WAVE_SIZE=25
DISPATCH_WAVE_PAUSE_MIN=10m
DISPATCH_WAVE_PAUSE_MAX=20m
DISPATCH_GROUP_PAUSE_MIN=20s
DISPATCH_GROUP_PAUSE_MAX=60s
DISPATCH_TYPING_MIN=2s
DISPATCH_TYPING_MAX=6s
DISPATCH_IDLE_POLL=5s
DISPATCH_WINDOW_START=08:00
DISPATCH_WINDOW_END=20:00
DISPATCH_WEEKENDS_ENABLED=false

# Warm-up and limits (0 — no limit)
WARMUP_ENABLED=true
WARMUP_DAILY_LIMITS=45,80,120,170,220
DAILY_SEND_LIMIT=0
HOURLY_SEND_LIMIT=120
# В одну группу — не чаще раза в интервал и только после чужого сообщения после нашего
GROUP_SEND_INTERVAL=60m
WAIT_FOR_REPLY=true

# Risk
RISK_WINDOW=1h
RISK_WARN_THRESHOLD=5
RISK_CRITICAL_THRESHOLD=10
RISK_PAUSE_MULTIPLIER=2.0

# Autoreply to direct messages and calls
AUTOREPLY_ENABLED=true
AUTOREPLY_REJECT_CALLS=true
AUTOREPLY_COOLDOWN=12h

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
NOTIFY_COOLDOWN=15m

# Logs
LOG_MAX_FILE_SIZE=20MB
LOG_MAX_HISTORY_DAYS=30
LOG_TOTAL_SIZE_CAP=2GB

# fake profile only
FAKE_GROUPS=30
FAKE_UNARCHIVED_GROUPS=3
FAKE_ADMIN_ONLY_GROUPS=2
FAKE_FAILURE_RATE=0.0
FAKE_SHEET_CSV=
