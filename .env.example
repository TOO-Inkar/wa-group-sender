# Профиль: prod — реальный WhatsApp и Google Sheets, fake — тестовый прогон без номера и таблицы
SPRING_PROFILES_ACTIVE=prod

# HTTP: по умолчанию порт слушает только localhost VPS (доступ через SSH-туннель)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Токен для /api/admin/*, /api/qr, /api/groups (заголовок X-Admin-Token). Сгенерируйте: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-long-random-string
ADMIN_TOKEN_HEADER=X-Admin-Token

APP_ZONE=Asia/Almaty

# WhatsApp (только отдельный тестовый номер заказчика)
WA_DEVICE_NAME=wa-group-sender
WA_SEND_TIMEOUT=60s
WA_METADATA_QUERY_DELAY=700ms
WA_METADATA_TTL=6h

# Watchdog: переподключение с экспоненциальной задержкой
WATCHDOG_CHECK_INTERVAL=15s
WATCHDOG_MAX_ATTEMPTS=8
WATCHDOG_INITIAL_DELAY=10s
WATCHDOG_MAX_DELAY=15m
WATCHDOG_CONNECT_TIMEOUT=3m

# Google Sheets. JSON-ключ положите в ./secrets/ (монтируется в /run/secrets)
SHEETS_ENABLED=true
SHEETS_SPREADSHEET_ID=
SHEETS_SHEET_NAME=Заявки
GOOGLE_CREDENTIALS_PATH=/run/secrets/google-service-account.json
SHEETS_POLL_INTERVAL=30s
SHEETS_FIRST_DATA_ROW=2
SHEETS_COL_ID=A
SHEETS_COL_ROUTE=B
SHEETS_COL_TONNAGE=C
SHEETS_COL_CARGO=D
SHEETS_COL_DATE=E
SHEETS_COL_FREIGHT=F
SHEETS_COL_STATUS=G
SHEETS_COL_PROGRESS=H
SHEETS_COL_COMPLETED=I
SHEETS_PROGRESS_FLUSH_INTERVAL=60s
SHEETS_RETRY_MAX_ATTEMPTS=5
SHEETS_RETRY_INITIAL_BACKOFF=2s
SHEETS_RETRY_MAX_BACKOFF=60s
SHEETS_ALERT_AFTER_FAILURES=10
SHEETS_COMPLETED_FORMAT=dd.MM.yyyy HH:mm

# Шаблон сообщения (./templates/message.txt на хосте)
TEMPLATE_PATH=/data/templates/message.txt

# Синхронизация групп
GROUPS_SYNC_INTERVAL=1h
GROUPS_INITIAL_SYNC_DELAY=60s

# Рассылка
DISPATCH_AUTOSTART=true
DISPATCH_WAVE_SIZE=25
DISPATCH_WAVE_PAUSE_MIN=10m
DISPATCH_WAVE_PAUSE_MAX=20m
DISPATCH_GROUP_PAUSE_MIN=20s
DISPATCH_GROUP_PAUSE_MAX=60s
DISPATCH_TYPING_MIN=2s
DISPATCH_TYPING_MAX=6s
DISPATCH_IDLE_POLL=5s
DISPATCH_WINDOW_START=08:00
DISPATCH_WINDOW_END=21:00
DISPATCH_WEEKENDS_ENABLED=true

# Прогрев: лимиты групп в сутки по дням от первой отправки, дальше без лимита
WARMUP_ENABLED=true
WARMUP_DAILY_LIMITS=50,100,150,250

# Мониторинг риска
RISK_WINDOW=1h
RISK_WARN_THRESHOLD=5
RISK_CRITICAL_THRESHOLD=10
RISK_PAUSE_MULTIPLIER=2.0

# Алерты: telegram, email или telegram,email
NOTIFY_CHANNEL=telegram
NOTIFY_COOLDOWN=15m
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (если NOTIFY_CHANNEL содержит email)
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_SUBJECT=wa-group-sender alert
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Логи
LOG_MAX_FILE_SIZE=20MB
LOG_MAX_HISTORY_DAYS=30
LOG_TOTAL_SIZE_CAP=2GB

# Только для профиля fake
FAKE_GROUPS=30
FAKE_UNARCHIVED_GROUPS=3
FAKE_ADMIN_ONLY_GROUPS=2
FAKE_FAILURE_RATE=0.0
FAKE_SEED_REQUESTS=1
