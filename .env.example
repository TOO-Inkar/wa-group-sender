# Профиль: prod — реальный WhatsApp и Google Sheets, fake — полный цикл без номера и таблицы (данные из docs/test-sheet.csv)
SPRING_PROFILES_ACTIVE=prod

# HTTP: по умолчанию порт слушает только localhost сервера (доступ через SSH-туннель)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Токен для /api/admin/*, /api/qr, /api/groups (заголовок X-Admin-Token). Сгенерируйте: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-long-random-string
ADMIN_TOKEN_HEADER=X-Admin-Token

APP_ZONE=Asia/Almaty

# Сообщение: контакт один на все заявки, нумерация 1️⃣2️⃣ по ID выключена
MESSAGE_CONTACT=
MESSAGE_NUMBERING=false
MESSAGE_TEMPLATE_PATH=/data/templates/message.txt

# WhatsApp (только отдельный тестовый номер). Клиент — сервис wa-bridge (whatsmeow), сессия в volume wa-bridge
WA_DEVICE_NAME=wa-group-sender
WA_SEND_TIMEOUT=60s
# Сколько ждать список групп: сразу после привязки wa-bridge ждёт синхронизацию признака архива
WA_GROUPS_TIMEOUT=4m
BRIDGE_LOG_LEVEL=INFO

# Watchdog: переподключение с экспоненциальной задержкой
WATCHDOG_CHECK_INTERVAL=15s
WATCHDOG_MAX_ATTEMPTS=8
WATCHDOG_INITIAL_DELAY=10s
WATCHDOG_MAX_DELAY=15m
WATCHDOG_CONNECT_TIMEOUT=3m

# Заявки вводятся в админке (вкладка «Новая заявка»). Чтение из Google Sheets выключено;
# чтобы включить: SHEETS_ENABLED=true, таблица и JSON-ключ в ./secrets/ (монтируется в /run/secrets только для чтения)
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_ID=
SHEETS_SHEET_NAME=Заявки
GOOGLE_CREDENTIALS_PATH=/run/secrets/google-service-account.json
SHEETS_POLL_INTERVAL=30s
SHEETS_HEADER_ROW=1
# Колонки ищутся по тексту заголовка (регистр и лишние пробелы не важны)
SHEETS_COL_ID=ID
SHEETS_COL_ROUTE=Маршрут
SHEETS_COL_DATE=Дата / срочность
SHEETS_COL_VEHICLES=Машины и тоннаж
SHEETS_COL_CARGO=Груз
SHEETS_COL_FREIGHT=Фрахт
SHEETS_COL_CONDITIONS=Доп. условия
SHEETS_COL_STATUS=Статус
SHEETS_COL_PROGRESS=Отправлено / всего
SHEETS_COL_COMPLETED=Завершено
SHEETS_PROGRESS_FLUSH_INTERVAL=60s
SHEETS_RETRY_MAX_ATTEMPTS=5
SHEETS_RETRY_INITIAL_BACKOFF=2s
SHEETS_RETRY_MAX_BACKOFF=60s
SHEETS_ALERT_AFTER_FAILURES=10
SHEETS_COMPLETED_FORMAT=yyyy-MM-dd HH:mm

# Синхронизация групп
GROUPS_SYNC_INTERVAL=1h
# Группы больше этого числа участников не участвуют в рассылке: сервер отклоняет отправку в них (ошибка 479).
# 0 — без ограничения
GROUPS_MAX_PARTICIPANTS=700
GROUPS_INITIAL_SYNC_DELAY=60s

# Рассылка
DISPATCH_AUTOSTART=true
DISPATCH_WAVE_SIZE=25
DISPATCH_WAVE_PAUSE_MIN=10m
DISPATCH_WAVE_PAUSE_MAX=20m
DISPATCH_GROUP_PAUSE_MIN=20s
DISPATCH_GROUP_PAUSE_MAX=60s
DISPATCH_TYPING_MIN=2s
DISPATCH_TYPING_MAX=6s
DISPATCH_IDLE_POLL=5s
DISPATCH_WINDOW_START=08:00
DISPATCH_WINDOW_END=20:00
DISPATCH_WEEKENDS_ENABLED=false

# Прогрев: лимит отправок в группы по дням от первой отправки; после последнего дня — весь список
WARMUP_ENABLED=true
WARMUP_DAILY_LIMITS=45,80,120,170,220

# Мониторинг риска
RISK_WINDOW=1h
RISK_WARN_THRESHOLD=5
RISK_CRITICAL_THRESHOLD=10
RISK_PAUSE_MULTIPLIER=2.0

# Алерты в Telegram: токен бота и chat_id через запятую (заказчик ТЗ, разработчик; клиентский чат добавить к запуску)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
NOTIFY_COOLDOWN=15m

# Логи
LOG_MAX_FILE_SIZE=20MB
LOG_MAX_HISTORY_DAYS=30
LOG_TOTAL_SIZE_CAP=2GB

# Только для профиля fake
FAKE_GROUPS=30
FAKE_UNARCHIVED_GROUPS=3
FAKE_ADMIN_ONLY_GROUPS=2
FAKE_FAILURE_RATE=0.0
FAKE_SHEET_CSV=
