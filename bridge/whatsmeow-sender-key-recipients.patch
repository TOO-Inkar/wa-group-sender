diff --git a/senderkeyrecipients.go b/senderkeyrecipients.go
new file mode 100644
index 0000000..aa1d039
--- /dev/null
+++ b/senderkeyrecipients.go
@@ -0,0 +1,27 @@
+package whatsmeow
+
+import (
+	"context"
+	"fmt"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+type SenderKeyRecipientStore interface {
+	FilterMissing(ctx context.Context, group types.JID, devices []types.JID) ([]types.JID, error)
+	MarkDistributed(ctx context.Context, group types.JID, devices []types.JID) error
+}
+
+func (cli *Client) missingSenderKeyRecipients(ctx context.Context, group types.JID, devices []types.JID) ([]types.JID, error) {
+	missing, err := cli.SenderKeyRecipients.FilterMissing(ctx, group, devices)
+	if err != nil {
+		return nil, fmt.Errorf("failed to get sender key recipients: %w", err)
+	}
+	return missing, nil
+}
+
+func (cli *Client) markSenderKeyRecipients(ctx context.Context, group types.JID, devices []types.JID) {
+	if err := cli.SenderKeyRecipients.MarkDistributed(ctx, group, devices); err != nil {
+		cli.Log.Warnf("Failed to remember sender key recipients in %s: %v", group, err)
+	}
+}
